# ============================================================
# Network Panel X server 环境变量示例
# 注意：所有密钥/密码均为占位符（***）。真实值只放本地 .env（已 gitignore），
#       绝不提交到 Git。部署到 Render 时填入其 Secret Environment Variables。
# ============================================================
PORT=8787
DB_HOST=gateway01.example.tidbcloud.com
DB_PORT=4000
DB_USERNAME=network_panel_app
# 【数据库密码】TiDB 账号密码
DB_PASSWORD=***
DB_DATABASE=network_panel_x
# 【TiDB CA 证书路径】本地开发用下载的 TiDB CA 证书，例如 Windows 下 E:\\isrgrootx1.pem
DATABASE_CA_PATH=E:\\isrgrootx1.pem
# 【JWT 签名密钥】至少 32 位随机字符串，用于登录会话 token 签名
JWT_SECRET=***
# 【跨域白名单】生产环境应改为 App 实际使用的 origin，* 为全放开（仅限调试）
ALLOWED_ORIGIN=*
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FAMILY=4
# 【发件邮箱账号】QQ 邮箱地址
SMTP_USERNAME=***
# 【SMTP 授权码】QQ 邮箱设置中生成的授权码（不是邮箱登录密码）
SMTP_PASSWORD=***
# 【发件人显示】格式：名称 <邮箱>
SMTP_FROM=Network Panel X <***>
